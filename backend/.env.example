# Porta do servidor Fastify
PORT=8000
HOST=0.0.0.0

# Origem permitida para CORS (separada por vírgula se múltiplas)
CORS_ORIGIN=http://localhost:3000

# Limite máximo de tamanho de granule HDF5 remoto em MB
MAX_GRANULE_MB=600

# Bearer Token pessoal NASA Earthdata (opcional - fallback global no servidor)
# Gere seu token em: https://urs.earthdata.nasa.gov -> Generate Token
# Se preenchido aqui, o backend usará este token automaticamente quando nenhum token for fornecido pelo cliente.
EARTHDATA_TOKEN=
